{
  "expo": {
    "name": "Optimal Week",
    "slug": "optimal-week",
    "version": "1.0.0",
    "scheme": "optimalweek",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davidearls.optimalweek",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Optimal Week reads your calendar so planned runs and appointments show up on the right day. It never writes to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "Optimal Week reads your calendar so planned runs and appointments show up on the right day. It never writes to your calendar.",
        "RCTAsyncStorageExcludeFromBackup": false
      }
    },
    "android": {
      "package": "com.davidearls.optimalweek",
      "adaptiveIcon": {
        "backgroundColor": "#E9ECEE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-calendar",
        {
          "calendarPermission": "Optimal Week reads your calendar so planned runs and appointments show up on the right day."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#E9ECEE",
          "dark": {
            "backgroundColor": "#0B1015"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
